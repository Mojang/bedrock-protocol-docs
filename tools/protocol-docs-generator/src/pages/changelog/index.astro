---
import ChangelogDetail from '../../components/ChangelogDetail.astro';
import VersionComparison from '../../components/VersionComparison.astro';
import { getProtocolMetadata, getVersionPrefix, versionManifest, withBase } from '../../data';
import metadataJson from '../../data/protocol.json';
import Layout from '../../layouts/Layout.astro';
import type { ProtocolChangelogRelease, ProtocolMetadata } from '../../types';

interface Props {
    comparison?: ProtocolChangelogRelease;
}

const { comparison } = Astro.props;
const metadata = metadataJson as ProtocolMetadata;
const latestMetadata = getProtocolMetadata('latest');
const releasesByVersion = new Map(versionManifest.releases.map(release => [release.version, release]));
const releaseId = (version: string, channel: string) =>
    `release-${channel === 'stable' ? '' : `${channel}-`}${version.replace(/[^a-zA-Z0-9]+/g, '-').toLowerCase()}`;
const packetHref = (version: string, slug: string) =>
    releasesByVersion.get(version)?.packetSlugs.includes(slug) ? `${getVersionPrefix(version)}/packets/${slug}/` : undefined;
const changelogChannels = [
    {
        description: 'Changes between stable protocol releases.',
        emptyMessage: 'No stable release history is available.',
        key: 'stable',
        label: 'Stable releases',
        releases: metadata.changelog.stable,
        tabLabel: 'Stable',
    },
    {
        description: 'Changes between consecutive stable releases and preview builds.',
        emptyMessage: 'No release history is available.',
        key: 'all',
        label: 'All builds',
        releases: metadata.changelog.all,
        tabLabel: 'All',
    },
    {
        description: '',
        emptyMessage: '',
        key: 'comparison',
        label: 'Compare versions',
        releases: comparison ? [comparison] : [],
        tabLabel: 'Compare',
    },
];
const defaultChannel = comparison ? 'comparison' : 'stable';
---

<Layout metadata={latestMetadata} title={comparison ? `Compare ${comparison.previousVersion} to ${comparison.version}` : 'Protocol changelog'} version="latest">
    <section class="masthead">
        <div>
            <h1>Protocol changelog</h1>
            <p class="lede">Packet changes across the latest tagged metadata releases.</p>
            <p><a class="back-link" href={withBase('/changelog/legacy/')}>Browse legacy changelogs →</a></p>
        </div>
    </section>

    <div class="changelog-view-toggle" role="tablist" aria-label="Changelog view">
        {changelogChannels.map(channel => (
            <button
                type="button"
                role="tab"
                id={`changelog-tab-${channel.key}`}
                aria-controls={`changelog-panel-${channel.key}`}
                aria-selected={channel.key === defaultChannel ? 'true' : 'false'}
                data-changelog-tab={channel.key}
                tabindex={channel.key === defaultChannel ? 0 : -1}
            >
                {channel.tabLabel}
            </button>
        ))}
    </div>

    {changelogChannels.map(channel => (
        <section
            class="changelog-channel"
            role="tabpanel"
            id={`changelog-panel-${channel.key}`}
            aria-labelledby={`changelog-tab-${channel.key}`}
            data-changelog-panel={channel.key}
            hidden={channel.key !== defaultChannel}
        >
            <header>
                <h2>{channel.label}</h2>
                {channel.description && <p>{channel.description}</p>}
            </header>
            {channel.key === 'comparison' && <VersionComparison from={comparison?.previousVersion} to={comparison?.version} />}
            {channel.releases.length > 0 ? (
                <>
                {channel.key !== 'comparison' && <nav class="category-toc changelog-toc" aria-label={`${channel.label} changelog releases`}>
                    <p>Releases · sorted by semantic version</p>
                    <div>
                        {channel.releases.map(release => (
                            <a href={`#${releaseId(release.version, channel.key)}`}>
                                {release.version}
                            </a>
                        ))}
                    </div>
                </nav>}

                <div class="changelog-releases">
                    {channel.releases.map(release => {
                        const packetCount =
                            release.packets.added.length +
                            release.packets.changed.length +
                            release.packets.removed.length;
                        return (
                            <section class="changelog-release" id={releaseId(release.version, channel.key)}>
                                <header class="changelog-release-header">
                                    <div>
                                        <h3>
                                            <a class="release-permalink" href={`#${releaseId(release.version, channel.key)}`}>
                                                {release.version}<span aria-hidden="true">#</span>
                                            </a>
                                        </h3>
                                    </div>
                                    <dl>
                                        <div><dt>Released</dt><dd><time datetime={release.releaseDate}>{release.releaseDate}</time></dd></div>
                                        <div><dt>Protocol</dt><dd>{release.protocolVersion}</dd></div>
                                        {channel.key !== 'stable' && <div><dt>{channel.key === 'comparison' ? 'From build' : 'Previous build'}</dt><dd>{release.previousVersion}</dd></div>}
                                    </dl>
                                </header>
                                {
                                    release.totalChanges > 0 && !release.versionDidChange && (
                                        <aside class="protocol-bump-warning" role="note">
                                            <strong>Protocol version should have changed.</strong>
                                            <span>
                                                This release contains {release.totalChanges} protocol changes, but both{' '}
                                                {release.previousVersion} and {release.version} use protocol{' '}
                                                <code>{release.protocolVersion}</code>.
                                            </span>
                                        </aside>
                                    )
                                }

                                <section class="changelog-scope">
                                    <header><h3>Packets</h3><span>{packetCount} changes</span></header>
                                    {release.packets.added.length > 0 && (
                                        <div class="changelog-group added">
                                            <h4>Added <span>{release.packets.added.length}</span></h4>
                                            <ul>
                                                {release.packets.added.map(item => (
                                                    <li>
                                                        {packetHref(release.version, item.slug) ? (
                                                            <a href={packetHref(release.version, item.slug)}>{item.title}</a>
                                                        ) : (
                                                            <strong>{item.title}</strong>
                                                        )}
                                                        <small>Packet ID {item.packetId}</small>
                                                        {item.changes.length > 0 && (
                                                            <ul class="changelog-subdetails">
                                                                {item.changes.map(change => <ChangelogDetail change={change} previousTypeSlugs={releasesByVersion.get(release.previousVersion)?.typeSlugs ?? []} previousVersionPrefix={getVersionPrefix(release.previousVersion)} typeSlugs={releasesByVersion.get(release.version)?.typeSlugs ?? []} versionPrefix={getVersionPrefix(release.version)} />)}
                                                            </ul>
                                                        )}
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                    )}
                                    {release.packets.removed.length > 0 && (
                                        <div class="changelog-group removed">
                                            <h4>Removed <span>{release.packets.removed.length}</span></h4>
                                            <ul>
                                                {release.packets.removed.map(item => (
                                                    <li>
                                                        {packetHref(release.previousVersion, item.slug) ? (
                                                            <a href={packetHref(release.previousVersion, item.slug)}>{item.title}</a>
                                                        ) : (
                                                            <strong>{item.title}</strong>
                                                        )}
                                                        <small>Packet ID {item.packetId}</small>
                                                        {item.changes.length > 0 && (
                                                            <ul class="changelog-subdetails">
                                                                {item.changes.map(change => <ChangelogDetail change={change} previousTypeSlugs={releasesByVersion.get(release.previousVersion)?.typeSlugs ?? []} previousVersionPrefix={getVersionPrefix(release.previousVersion)} typeSlugs={releasesByVersion.get(release.version)?.typeSlugs ?? []} versionPrefix={getVersionPrefix(release.version)} />)}
                                                            </ul>
                                                        )}
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                    )}
                                    {release.packets.changed.length > 0 && (
                                        <div class="changelog-group changed">
                                            <h4>Changed <span>{release.packets.changed.length}</span></h4>
                                            <div class="changelog-details">
                                                {release.packets.changed.map(item => (
                                                    <article>
                                                        <header>
                                                            {packetHref(release.version, item.slug) ? (
                                                                <a href={packetHref(release.version, item.slug)}>{item.title}</a>
                                                            ) : (
                                                                <strong>{item.title}</strong>
                                                            )}
                                                            <span>{item.changes.length} changes · ID {item.packetId}</span>
                                                        </header>
                                                        <ul>
                                                            {item.previousPacketId !== undefined && (
                                                                <li>Changed packet ID from {item.previousPacketId} to {item.packetId}.</li>
                                                            )}
                                                            {item.changes.map(change => <ChangelogDetail change={change} previousTypeSlugs={releasesByVersion.get(release.previousVersion)?.typeSlugs ?? []} previousVersionPrefix={getVersionPrefix(release.previousVersion)} typeSlugs={releasesByVersion.get(release.version)?.typeSlugs ?? []} versionPrefix={getVersionPrefix(release.version)} />)}
                                                        </ul>
                                                    </article>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                    {packetCount === 0 && <p class="empty-state">No packet changes.</p>}
                                </section>
                            </section>
                        );
                    })}
                </div>
                </>
            ) : channel.emptyMessage && (
                <p class="empty-state changelog-empty">{channel.emptyMessage}</p>
            )}
        </section>
    ))}
</Layout>

<script>
    const changelogTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-changelog-tab]'));
    const changelogPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-changelog-panel]'));

    const selectChangelogChannel = (channel: string, moveFocus = false) => {
        for (const tab of changelogTabs) {
            const selected = tab.dataset.changelogTab === channel;
            tab.setAttribute('aria-selected', String(selected));
            tab.tabIndex = selected ? 0 : -1;
            if (selected && moveFocus) tab.focus();
        }
        for (const panel of changelogPanels) panel.hidden = panel.dataset.changelogPanel !== channel;
    };

    for (const [index, tab] of changelogTabs.entries()) {
        tab.addEventListener('click', () => selectChangelogChannel(tab.dataset.changelogTab ?? 'stable'));
        tab.addEventListener('keydown', event => {
            if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
            event.preventDefault();
            const direction = event.key === 'ArrowRight' ? 1 : -1;
            const nextTab = changelogTabs[(index + direction + changelogTabs.length) % changelogTabs.length];
            selectChangelogChannel(nextTab.dataset.changelogTab ?? 'stable', true);
        });
    }

    const selectChannelForHash = () => {
        const target = document.getElementById(location.hash.slice(1));
        const panel = target?.closest<HTMLElement>('[data-changelog-panel]');
        if (panel?.dataset.changelogPanel) selectChangelogChannel(panel.dataset.changelogPanel);
    };

    selectChannelForHash();
    window.addEventListener('hashchange', selectChannelForHash);
</script>