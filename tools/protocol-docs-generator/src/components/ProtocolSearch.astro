---
interface Props {
    advancedSearchUrl: string;
    indexUrl: string;
}

const { advancedSearchUrl, indexUrl } = Astro.props;
---

<div class="directory-tools protocol-search">
    <label class="sr-only" for="directory-search">Search reference</label>
    <div class="search-control">
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input
            id="directory-search"
            type="search"
            placeholder="Search protocol reference"
            autocomplete="off"
            aria-controls="protocol-search-results"
            aria-expanded="false"
        />
        <div id="protocol-search-results" class="search-results" hidden></div>
    </div>
    <a class="advanced-search-link" id="advanced-search-link" href={advancedSearchUrl}>Advanced search</a>
</div>
<meta id="protocol-search-data" data-index-url={indexUrl} />

<script>
    import { searchEntries, type SearchEntry } from '../search-client';

    const input = document.querySelector<HTMLInputElement>('#directory-search');
    const results = document.querySelector<HTMLElement>('#protocol-search-results');
    const data = document.querySelector<HTMLElement>('#protocol-search-data');
    const advancedSearchLink = document.querySelector<HTMLAnchorElement>('#advanced-search-link');
    let entriesPromise: Promise<SearchEntry[]> | undefined;

    const loadEntries = () => {
        if (!entriesPromise) {
            entriesPromise = fetch(data?.dataset.indexUrl ?? '')
                .then(response => {
                    if (!response.ok) throw new Error(`Search index request failed with ${response.status}.`);
                    return response.json() as Promise<SearchEntry[]>;
                })
                .catch(error => {
                    entriesPromise = undefined;
                    throw error;
                });
        }
        return entriesPromise;
    };

    const closeResults = () => {
        if (results) results.hidden = true;
        input?.setAttribute('aria-expanded', 'false');
    };

    const positionResults = () => {
        if (!input || !results || getComputedStyle(results).position !== 'fixed') return;
        const inputBounds = input.getBoundingClientRect();
        results.style.top = `${inputBounds.bottom + 8}px`;
        results.style.left = `${inputBounds.left}px`;
    };

    input?.addEventListener('input', async () => {
        const query = input.value.trim().toLowerCase();
        if (advancedSearchLink) {
            const url = new URL(advancedSearchLink.href);
            if (query) url.searchParams.set('q', input.value.trim());
            else url.searchParams.delete('q');
            advancedSearchLink.href = url.href;
        }
        if (!results || !query) {
            closeResults();
            return;
        }

        let entries: SearchEntry[];
        try {
            entries = await loadEntries();
        } catch {
            closeResults();
            return;
        }
        if (query !== input.value.trim().toLowerCase()) return;

        const matches = searchEntries(entries, query);
        const fragment = document.createDocumentFragment();
        for (const { entry, matchingMembers } of matches) {
            const link = document.createElement('a');
            const heading = document.createElement('strong');
            const kind = document.createElement('span');
            link.href = entry.href;
            heading.textContent = entry.title;
            kind.textContent = entry.kind === 'Packet' && entry.id !== undefined ? `Packet ${entry.id}` : entry.kind;
            link.append(kind, heading);
            if (matchingMembers.length > 0) {
                for (const member of matchingMembers.slice(0, 3)) {
                    const memberDetail = document.createElement('small');
                    const memberPath = document.createElement('span');
                    const memberType = document.createElement('code');
                    memberDetail.className = 'search-member';
                    memberPath.textContent = member.path;
                    memberType.textContent = member.type;
                    memberDetail.append(memberType, memberPath);
                    link.append(memberDetail);
                }
                if (matchingMembers.length > 3) {
                    const remaining = document.createElement('small');
                    remaining.className = 'search-member-more';
                    remaining.textContent = `+${matchingMembers.length - 3} more matching members`;
                    link.append(remaining);
                }
            } else {
                const description = document.createElement('small');
                description.textContent = entry.description;
                link.append(description);
            }
            fragment.append(link);
        }
        results.replaceChildren(fragment);
        positionResults();
        results.hidden = false;
        input.setAttribute('aria-expanded', 'true');
    });

    document.addEventListener('click', event => {
        if (!(event.target instanceof Node) || !event.target.parentElement?.closest('.protocol-search')) closeResults();
    });
    document.addEventListener('keydown', event => {
        if (event.key === 'Escape') closeResults();
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault();
            input?.focus();
        }
    });
    window.addEventListener('resize', positionResults);
    window.addEventListener('scroll', positionResults, true);
</script>