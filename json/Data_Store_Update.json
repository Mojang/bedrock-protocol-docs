{
    "title": "Data Store Update",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/Data_Store_Update.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.70-beta.24",
    "x-protocol-version": 2259,
    "type": "object",
    "properties": {
        "Data": {
            "description": "The variable value being updated",
            "oneOf": [
                {
                    "type": "number",
                    "x-underlying-type": "double",
                    "x-ordinal-index": 0
                },
                {
                    "type": "boolean",
                    "x-underlying-type": "boolean",
                    "x-ordinal-index": 1
                },
                {
                    "type": "string",
                    "x-ordinal-index": 2,
                    "maxLength": 5000
                }
            ],
            "x-control-value-type": "uint32",
            "x-ordinal-index": 1
        },
        "Update Count": {
            "description": "The number of times this variable has updated",
            "type": "integer",
            "x-underlying-type": "uint32",
            "x-ordinal-index": 2,
            "minimum": 0.0,
            "maximum": 4294967294.0
        },
        "Variable Name": {
            "type": "string",
            "x-ordinal-index": 0,
            "minLength": 1,
            "maxLength": 2000
        }
    },
    "required": [
        "Data",
        "Update Count",
        "Variable Name"
    ]
}