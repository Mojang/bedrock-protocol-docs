{
    "title": "VirtualContainerOpenPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/VirtualContainerOpenPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.70-beta.24",
    "x-protocol-version": 2259,
    "type": "object",
    "properties": {
        "Container Id": {
            "description": "The id of the screen being opened. Later inventory packets for the screen use this id.",
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Enum-as-Value"
            ],
            "x-ordinal-index": 0,
            "minimum": 0.0,
            "maximum": 255.0
        },
        "Session Id": {
            "description": "Connection-scoped opening identity. Every VirtualContainerClosePacket for the screen refers to it.",
            "type": "integer",
            "x-underlying-type": "uint64",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 1,
            "minimum": 1.0
        },
        "Slots": {
            "description": "Every initial slot, including empty slots and server net IDs. The array length is the capacity.",
            "type": "array",
            "items": {
                "$ref": "./NetworkItemStackDescriptor.json"
            },
            "x-ordinal-index": 3,
            "minItems": 1,
            "maxItems": 54
        },
        "Title": {
            "description": "The screen heading. Localized on the client when it names a localization key.",
            "type": "string",
            "x-ordinal-index": 2,
            "maxLength": 256
        }
    },
    "required": [
        "Container Id",
        "Session Id",
        "Slots",
        "Title"
    ]
}