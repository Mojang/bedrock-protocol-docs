{
    "title": "TextPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/TextPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.50-beta.25",
    "x-protocol-version": 2187,
    "type": "object",
    "properties": {
        "Body": {
            "oneOf": [
                {
                    "$ref": "./MessageOnly.json"
                },
                {
                    "$ref": "./AuthorAndMessage.json"
                },
                {
                    "$ref": "./MessageAndParams.json"
                }
            ],
            "x-control-value-type": "uint32",
            "x-ordinal-index": 1
        },
        "Filtered Message": {
            "type": "string",
            "x-ordinal-index": 4,
            "maxLength": 65536
        },
        "Localize?": {
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 0
        },
        "Platform Id": {
            "type": "string",
            "default": "",
            "x-ordinal-index": 3,
            "maxLength": 256
        },
        "Sender's XUID": {
            "type": "string",
            "default": "",
            "x-ordinal-index": 2,
            "maxLength": 64
        }
    },
    "required": [
        "Body",
        "Localize?"
    ]
