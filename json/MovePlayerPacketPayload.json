                "Respawn",
                "Teleport",
                "OnlyHeadRot"
            ],
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Enum-as-Value"
            ],
            "x-ordinal-index": 4
        },
        "Riding Runtime ID": {
            "$ref": "./ActorRuntimeID.json",
            "x-ordinal-index": 6
