            "$ref": "./Vec2.json",
            "x-ordinal-index": 2
        },
        "Teleport Data": {
            "$ref": "./MovePlayerTeleportData.json",
            "x-ordinal-index": 7
        },
        "Tick": {
            "$ref": "./PlayerInputTick.json",
            "x-ordinal-index": 8
