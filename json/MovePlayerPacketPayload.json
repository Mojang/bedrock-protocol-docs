{
    "title": "MovePlayerPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/MovePlayerPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.50-beta.26",
    "x-protocol-version": 2192,
