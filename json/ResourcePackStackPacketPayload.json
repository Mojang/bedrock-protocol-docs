{
    "title": "ResourcePackStackPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/ResourcePackStackPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.70-beta.22",
    "x-protocol-version": 2239,
    "type": "object",
    "properties": {
        "Base Game Version": {
            "description": "For clients to be able to set their stack to the right version",
            "type": "string",
            "x-ordinal-index": 2
        },
        "Editor Pack Types": {
            "description": "Bit flags for the built-in Editor packs that the client adds to its stack: 0x1 Core, 0x2 Annotation. Other bits are invalid.",
            "$ref": "./EditorPackType.json",
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Enum-as-Value",
                "Allow unknown enum values"
            ],
            "x-ordinal-index": 4
        },
        "Experiments": {
            "description": "Active and always-on experiment toggles",
            "$ref": "./Experiments.json",
            "x-ordinal-index": 3
        },
        "Texture Pack List": {
            "description": "List of texture pack IDs and versions for the resource pack stack",
            "type": "array",
            "items": {
                "$ref": "./PackInstanceId.json"
            },
            "x-ordinal-index": 1,
            "maxItems": 65535
        },
        "Texture Pack Required": {
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 0
        }
    },
    "required": [
        "Base Game Version",
        "Editor Pack Types",
        "Experiments",
        "Texture Pack List",
        "Texture Pack Required"
    ]
}