{
    "title": "MessageOnly",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/MessageOnly.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.60-beta.21",
    "x-protocol-version": 2207,
    "type": "object",
    "properties": {
        "Message": {
            "type": "string",
            "default": "",
            "x-ordinal-index": 1,
            "minLength": 1,
            "maxLength": 65536
        },
        "Message Type": {
            "type": "string",
            "enum": [
                "raw",
                "tip",
                "systemMessage",
                "textObjectWhisper",
                "textObject",
                "textObjectAnnouncement"
            ],
            "x-underlying-type": "uint8",
            "x-serialization-options": [
                "Compression",
                "Enum-as-Value"
            ],
            "x-ordinal-index": 0,
            "x-enum-binary-value": [
                0,
                5,
                6,
                9,
                10,
                11
            ]
        }
    },
    "required": [
        "Message Type"
    ]
}