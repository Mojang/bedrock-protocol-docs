        },
        "Npc Name": {
            "type": "string",
            "x-ordinal-index": 4
        },
        "Scene Name": {
            "type": "string",
            "x-ordinal-index": 3
        }
    },
    "required": [
        "Action JSON",
        "Dialogue",
        "Npc Dialogue Action Type",
        "Npc Id Raw Id",
        "Npc Name",
        "Scene Name"
