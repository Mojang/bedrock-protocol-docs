{
    "title": "ClientboundMapItemDataPacketPayload",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/ClientboundMapItemDataPacketPayload.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.50-beta.26",
    "x-protocol-version": 2192,
    "type": "object",
    "properties": {
        "Creation Map IDs": {
            "type": "array",
            "items": {
                "$ref": "./ActorUniqueID.json"
            },
            "x-ordinal-index": 4,
            "maxItems": 65535
        },
        "Decorations": {
            "type": "array",
            "items": {
                "$ref": "./MapDecoration.json"
            },
            "x-ordinal-index": 7,
            "maxItems": 65535
        },
        "Dimension": {
            "type": "integer",
            "x-underlying-type": "uint8",
            "x-ordinal-index": 1,
            "minimum": 0.0,
            "maximum": 255.0
        },
        "Height": {
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 9
        },
        "Is Locked": {
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 2
        },
        "Map ID": {
            "$ref": "./ActorUniqueID.json",
            "x-ordinal-index": 0
        },
        "Map Origin": {
            "$ref": "./BlockPos.json",
            "x-ordinal-index": 3
        },
        "Pixels": {
            "type": "array",
            "items": {
                "type": "integer",
                "x-underlying-type": "uint32",
                "minimum": 0.0
            },
            "x-ordinal-index": 12,
            "maxItems": 16384
        },
        "Scale": {
            "type": "integer",
            "x-underlying-type": "int8",
            "x-ordinal-index": 5,
            "minimum": -128.0,
            "maximum": 127.0
        },
        "Start X": {
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 10
        },
        "Start Y": {
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 11
        },
        "Tracked Actor IDs": {
            "type": "array",
            "items": {
                "$ref": "./MapItemTrackedActor_UniqueId.json"
            },
            "x-ordinal-index": 6,
            "maxItems": 65535
        },
        "Width": {
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 8
        }
