{
    "title": "DimensionDefinition",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/DimensionDefinition.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.50-beta.26",
    "x-protocol-version": 2192,
    "type": "object",
    "properties": {
        "Default Biome": {
            "description": "Identifier of the biome a custom dimension generates with.",
            "type": "string",
            "x-ordinal-index": 5,
            "maxLength": 256
        },
        "Dimension Type": {
            "description": "Dimension runtime ID.",
            "$ref": "./DimensionType.json",
            "x-ordinal-index": 3
        },
        "Generator Type": {
            "type": "string",
            "enum": [
                "Legacy",
                "Overworld",
                "Flat",
                "Nether",
                "TheEnd",
                "Void",
                "Undefined"
            ],
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression",
                "Enum-as-Value"
            ],
            "x-ordinal-index": 2
        },
        "Height Range": {
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 1
        },
        "Minimum Y": {
            "type": "integer",
            "x-underlying-type": "int32",
            "x-serialization-options": [
                "Compression"
            ],
            "x-ordinal-index": 0
        },
        "Pack Id": {
            "description": "UUID of the pack that registered this dimension.",
            "$ref": "./mce__UUID.json",
            "x-ordinal-index": 4
        }
    },
    "required": [
        "Default Biome",
        "Dimension Type",
        "Generator Type",
        "Height Range",
        "Minimum Y",
        "Pack Id"
    ]
}